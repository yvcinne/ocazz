APP_NAME=ocazz
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ocazz
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Email — utiliser "log" en dev (emails dans storage/logs/laravel.log)
# Remplacer par "smtp" + identifiants Resend en production
MAIL_MAILER=log
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=onboarding@resend.dev
MAIL_FROM_NAME="${APP_NAME}"
MAIL_PASSWORD=

# Gemini API — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Service de prédiction Flask (python prediction/api/app.py)
PREDICTION_SERVICE_URL=http://127.0.0.1:5000
